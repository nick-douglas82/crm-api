      "binding": "DB",
      "database_name": "crm-db",
      "database_id": "7c1be8e4-6b98-4ce7-8d5c-cc991ccbfb94",
      "migrations_dir": "drizzle",
    },
  ],
  "compatibility_flags": ["nodejs_compat"],
