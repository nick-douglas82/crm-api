{
  "name": "crm-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx wrangler d1 migrations apply crm-db --local",
    "db:seed": "bun run scripts/seed/index.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@types/node": "^26.6.6",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.110.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
